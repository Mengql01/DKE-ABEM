* EQUATIONS "Wizard_Settings"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  12
! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     HEMISPHERE = 1
! Building rotation angle, 0=no rotation. TURN [degrees]; to -> [28,?] AAZM_TYPE56 calculation                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     TURN = HEMISPHERE * 0
! Boundary temperature flag, 0=use TGROUND from Type77. TBOUNDARY [-]; to -> [3,9] TBOUNDARY                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     TBOUNDARY = 0
! Radiation threshold to close window shades. SHADE_CLOSE [W/m2]; to -> [3,10] SHADE_CLOSE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     SHADE_CLOSE = 200
! Radiation threshold to open window shades. SHADE_OPEN [W/m2]; to -> [3,11] SHADE_OPEN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     SHADE_OPEN = 100
! Maximum internal shade factor (0=no shade, 1=fully shaded). MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     MAX_ISHADE = 0.5
! Maximum external shade factor (0=no shade, 1=fully shaded). MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     MAX_ESHADE = 0.5
! Depth of heat transfer node for building surfaces. h_DEPTH [m]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     h_DEPTH = 0.1
! Mean annual surface temperature for ground coupling. T_MEAN [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     T_MEAN = 10.0
! Amplitude of surface temperature variation. T_AMPLITUDE [deltaC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     T_AMPLITUDE = 5.0
! Day of year when minimum surface temperature occurs. t_T_MIN [day]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     t_T_MIN = 30
! Flag to use Type77 soil temperature for ground boundary. TGROUND_FLAG [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     TGROUND_FLAG = 1
*$UNIT_NAME Wizard_Settings                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
