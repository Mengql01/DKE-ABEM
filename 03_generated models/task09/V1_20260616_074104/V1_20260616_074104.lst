* EQUATIONS "Heating_Capacity_Limits"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   5
! Maximum reheat capacity for LOWER1 based on max airflow 917 L/s, air density 1.2 kg/m³, Cp_air 1.007 kJ/(kg.K), max reheat temp 35°C. HtCap_LOWER1 [kJ/hr]; from [3,1] TAIR_LOWER1 [°C]; to -> [7,11] Input Value-11 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     HtCap_LOWER1 = MAX((917.*3600./1000.*1.2*1.007*(35 - [3,1])),0.)
! Maximum reheat capacity for LOWER2 based on max airflow 817 L/s. HtCap_LOWER2 [kJ/hr]; from [3,2] TAIR_LOWER2 [°C]; to -> [7,12] Input Value-12 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     HtCap_LOWER2 = MAX((817.*3600./1000.*1.2*1.007*(35 - [3,2])),0.)
! Maximum reheat capacity for LOWER3 based on max airflow 1069 L/s. HtCap_LOWER3 [kJ/hr]; from [3,3] TAIR_LOWER3 [°C]; to -> [7,13] Input Value-13 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     HtCap_LOWER3 = MAX((1069.*3600./1000.*1.2*1.007*(35 - [3,3])),0.)
! Maximum reheat capacity for LOWER4 based on max airflow 921 L/s. HtCap_LOWER4 [kJ/hr]; from [3,4] TAIR_LOWER4 [°C]; to -> [7,14] Input Value-14 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     HtCap_LOWER4 = MAX((921.*3600./1000.*1.2*1.007*(35 - [3,4])),0.)
! Maximum reheat capacity for UPPER based on max airflow 3786 L/s. HtCap_UPPER [kJ/hr]; from [3,5] TAIR_UPPER [°C]; to -> [7,15] Input Value-15 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     HtCap_UPPER = MAX((3786.*3600./1000.*1.2*1.007*(35 - [3,5])),0.)
*$UNIT_NAME Heating_Capacity_Limits                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
