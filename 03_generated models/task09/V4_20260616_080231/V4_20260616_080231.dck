* EQUATIONS "Wizard_Settings"
*
EQUATIONS 12
HEMISPHERE = 1 ! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]
TURN = HEMISPHERE * 0 ! Building rotation angle. TURN [degrees]
TBOUNDARY = 20 ! Boundary temperature for building model. TBOUNDARY [°C]; to -> [3,9] TBOUNDARY [°C]
SHADE_CLOSE = 140 * 3.6 ! Radiation threshold to close blinds, converted from W/m2 to kJ/hr.m2. SHADE_CLOSE [kJ/hr.m2]; to -> [3,10] SHADE_CLOSE [kJ/hr.m2]
SHADE_OPEN = 40 * 3.6 ! Radiation threshold to open blinds, converted from W/m2 to kJ/hr.m2. SHADE_OPEN [kJ/hr.m2]; to -> [3,11] SHADE_OPEN [kJ/hr.m2]
MAX_ISHADE = 0.5 ! Maximum internal shading factor. MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE [-]
MAX_ESHADE = 0.5 ! Maximum external shading factor. MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE [-]
h_DEPTH = 0.25 ! Depth below ground surface for soil temperature node. h_DEPTH [m]; to -> [4,8] Depth at point [m]
T_MEAN = 10.0 ! Mean annual ground surface temperature. T_MEAN [°C]; to -> [4,2] Mean surface temperature [°C]
T_AMPLITUDE = 5.0 ! Amplitude of ground surface temperature variation. T_AMPLITUDE [deltaC]; to -> [4,3] Amplitude of surface temperature [deltaC]
t_T_MIN = 30 ! Day of year when minimum ground surface temperature occurs. t_T_MIN [day]; to -> [4,4] Time shift [day]
T_SET = 22 ! Default temperature setpoint placeholder. T_SET [°C]
*$UNIT_NAME Wizard_Settings
*$LAYER Main
*$POSITION 140 1763
*$UNIT_NUMBER 26
*------------------------------------------------------------------------------

* EQUATIONS "Radiation_Unit_Converter"
*
EQUATIONS 7
AZEN = [2,16] ! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] Solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]
AAZM = [2,17] ! Solar azimuth angle from weather data. AAZM [degrees]; from [2,17] Solar azimuth angle [degrees]
AAZM_TYPE56 = AAZM - (TURN) ! Solar azimuth angle corrected by building rotation for Type56. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]
AA_H_0_0 = 0 + TURN ! Azimuth angle of horizontal surface (slope 0°, azimuth 0°). AA_H_0_0 [degrees]
IT_H_0_0 = [2,24]/3.6 ! Total tilted surface radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IT_H_0_0 [W/m2]; from [2,24] Total radiation on surface 1 [kJ/hr.m2]
IB_H_0_0 = [2,31]/3.6 ! Beam radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IB_H_0_0 [W/m2]; from [2,31] Beam radiation on surface 1 [kJ/hr.m2]
AI_H_0_0 = [2,59] ! Angle of incidence on horizontal surface. AI_H_0_0 [degrees]; from [2,59] Incidence angle for surface 1 [degrees]
*$UNIT_NAME Radiation_Unit_Converter
*$LAYER Main
*$POSITION 392.0 755.0
*$UNIT_NUMBER 27
*------------------------------------------------------------------------------

* EQUATIONS "Fluid_Properties"
*
EQUATIONS 3
Cp_H2O = 4.19 ! Specific heat of water. Cp_H2O [kJ/(kg.K)]
rho_H2O = 1000. ! Density of water. rho_H2O [kg/m³]
k_H2O = 2.224 ! Thermal conductivity of water. k_H2O [kJ/(h.m.K)]
*$UNIT_NAME Fluid_Properties
*$LAYER Main
*$POSITION 140 1859
*$UNIT_NUMBER 28
*------------------------------------------------------------------------------

* EQUATIONS "Outdoor_Convection"
*
EQUATIONS 2
windSpeed_corr = MAX(0, [2,8]) ! Corrected wind speed eliminating negative values from weather file. windSpeed_corr [m/s]; from [2,8] Wind velocity [m/s]
h_outside = 3.6 * (3.8 * windSpeed_corr + 7.4) ! Outdoor convection coefficient using wind-speed-dependent formula. h_outside [kJ/(h.m².K)]
*$UNIT_NAME Outdoor_Convection
*$LAYER Main
*$POSITION 392.0 307.0
*$UNIT_NUMBER 29
*------------------------------------------------------------------------------

* EQUATIONS "Floor_Areas"
*
EQUATIONS 5
flr_LOWER1 = 150. ! Floor area of zone LOWER1. flr_LOWER1 [m²]
flr_LOWER2 = 150. ! Floor area of zone LOWER2. flr_LOWER2 [m²]
flr_LOWER3 = 150. ! Floor area of zone LOWER3. flr_LOWER3 [m²]
flr_LOWER4 = 150. ! Floor area of zone LOWER4. flr_LOWER4 [m²]
flr_UPPER = 400. ! Floor area of zone UPPER. flr_UPPER [m²]
*$UNIT_NAME Floor_Areas
*$LAYER Main
*$POSITION 140 1379.0
*$UNIT_NUMBER 30
*------------------------------------------------------------------------------

* EQUATIONS "Gains"
*
EQUATIONS 17
lgt_LOWER1 = (13.)*flr_LOWER1*3.6*[15,1] ! Lighting gain for LOWER1, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER1 [kJ/hr]; from [15,1] Forcing function output for current day [-]; to -> [3,?] LIGHT_LOWER1 [kJ/hr]
lgt_LOWER2 = (13.)*flr_LOWER2*3.6*[15,1] ! Lighting gain for LOWER2, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER2 [kJ/hr]; from [15,1] Forcing function output for current day [-]
lgt_LOWER3 = (13.)*flr_LOWER3*3.6*[15,1] ! Lighting gain for LOWER3, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER3 [kJ/hr]; from [15,1] Forcing function output for current day [-]
lgt_LOWER4 = (13.)*flr_LOWER4*3.6*[15,1] ! Lighting gain for LOWER4, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER4 [kJ/hr]; from [15,1] Forcing function output for current day [-]
lgt_UPPER = (13.)*flr_UPPER*3.6*[15,1] ! Lighting gain for UPPER, 13 W/m² converted to kJ/hr with schedule. lgt_UPPER [kJ/hr]; from [15,1] Forcing function output for current day [-]
eqp_LOWER1 = (21.5)*flr_LOWER1*3.6*[15,1] ! Equipment gain for LOWER1, 21.5 W/m² converted to kJ/hr with schedule. eqp_LOWER1 [kJ/hr]; from [15,1] Forcing function output for current day [-]
eqp_LOWER2 = (21.5)*flr_LOWER2*3.6*[15,1] ! Equipment gain for LOWER2, 21.5 W/m² converted to kJ/hr with schedule. eqp_LOWER2 [kJ/hr]; from [15,1] Forcing function output for current day [-]
eqp_LOWER3 = (21.5)*flr_LOWER3*3.6*[15,1] ! Equipment gain for LOWER3, 21.5 W/m² converted to kJ/hr with schedule. eqp_LOWER3 [kJ/hr]; from [15,1] Forcing function output for current day [-]
eqp_LOWER4 = (21.5)*flr_LOWER4*3.6*[15,1] ! Equipment gain for LOWER4, 21.5 W/m² converted to kJ/hr with schedule. eqp_LOWER4 [kJ/hr]; from [15,1] Forcing function output for current day [-]
eqp_UPPER = (21.5)*flr_UPPER*3.6*[15,1] ! Equipment gain for UPPER, 21.5 W/m² converted to kJ/hr with schedule. eqp_UPPER [kJ/hr]; from [15,1] Forcing function output for current day [-]
peo_LOWER1 = flr_LOWER1/(20.)*[11,1] ! Occupant count for LOWER1, 20 m²/person with occupancy schedule. peo_LOWER1 [-]; from [11,1] Forcing function output for current day [-]
peo_LOWER2 = flr_LOWER2/(20.)*[11,1] ! Occupant count for LOWER2, 20 m²/person with occupancy schedule. peo_LOWER2 [-]; from [11,1] Forcing function output for current day [-]
peo_LOWER3 = flr_LOWER3/(20.)*[11,1] ! Occupant count for LOWER3, 20 m²/person with occupancy schedule. peo_LOWER3 [-]; from [11,1] Forcing function output for current day [-]
peo_LOWER4 = flr_LOWER4/(20.)*[11,1] ! Occupant count for LOWER4, 20 m²/person with occupancy schedule. peo_LOWER4 [-]; from [11,1] Forcing function output for current day [-]
peo_UPPER = flr_UPPER/(20.)*[11,1] ! Occupant count for UPPER, 20 m²/person with occupancy schedule. peo_UPPER [-]; from [11,1] Forcing function output for current day [-]
lgt_Total = lgt_LOWER1 + lgt_LOWER2 + lgt_LOWER3 + lgt_LOWER4 + lgt_UPPER ! Total lighting load across all zones. lgt_Total [kJ/hr]; to -> [24,1] Input to be integrated & printed [kJ/hr]; to -> [25,1] Input to be integrated & printed [kJ/hr]
eqp_Total = eqp_LOWER1 + eqp_LOWER2 + eqp_LOWER3 + eqp_LOWER4 + eqp_UPPER ! Total equipment load across all zones. eqp_Total [kJ/hr]; to -> [24,1] Input to be integrated & printed [kJ/hr]; to -> [25,1] Input to be integrated & printed [kJ/hr]
*$UNIT_NAME Gains
*$LAYER Main
*$POSITION 552 147
*$UNIT_NUMBER 31
*------------------------------------------------------------------------------

* EQUATIONS "OA_Quantity"
*
EQUATIONS 6
lpsOA_LOWER1 = (0.3)*flr_LOWER1 + (2.5)*8. ! Required outside air for LOWER1 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER1 [L/s]
lpsOA_LOWER2 = (0.3)*flr_LOWER2 + (2.5)*8. ! Required outside air for LOWER2 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER2 [L/s]
lpsOA_LOWER3 = (0.3)*flr_LOWER3 + (2.5)*8. ! Required outside air for LOWER3 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER3 [L/s]
lpsOA_LOWER4 = (0.3)*flr_LOWER4 + (2.5)*8. ! Required outside air for LOWER4 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER4 [L/s]
lpsOA_UPPER = (0.3)*flr_UPPER + (2.5)*10. ! Required outside air for UPPER using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 10 people. lpsOA_UPPER [L/s]
fOA = (lpsOA_LOWER1 + lpsOA_LOWER2 + lpsOA_LOWER3 + lpsOA_LOWER4 + lpsOA_UPPER) / 7510. * [19,1] ! Fraction of outside air relative to design dry air flow 7510 L/s, modulated by weekly ventilation schedule. fOA [-]; from [19,1] Forcing function output for current day [-]; to -> [5,6] Fraction of outside air [-]
*$UNIT_NAME OA_Quantity
*$LAYER Main
*$POSITION 552 307.0
*$UNIT_NUMBER 32
*------------------------------------------------------------------------------

* EQUATIONS "Cooling_Setpoint"
*
EQUATIONS 1
T_COOL_SET = 26.7 ! Cooling setpoint temperature, constant year-round. T_COOL_SET [°C]; to -> [3,?] COOLING_SETPOINT [°C]
*$UNIT_NAME Cooling_Setpoint
*$LAYER Main
*$POSITION 140 563.0
*$UNIT_NUMBER 33
*------------------------------------------------------------------------------

* EQUATIONS "DX_Cooling_Control"
*
EQUATIONS 1
DX_Cooling_Ctrl = GT([5,2], 0) ! DX cooling coil control signal, activated when AHU cooling coil heat transfer is positive. DX_Cooling_Ctrl [-]; from [5,2] Cooling coil heat transfer [kJ/hr]; to -> [6,14] Cooling Control Signal [-]
*$UNIT_NAME DX_Cooling_Control
*$LAYER Main
*$POSITION 1052 307.0
*$UNIT_NUMBER 34
*------------------------------------------------------------------------------

* EQUATIONS "Heating_Capacity_Limits"
*
EQUATIONS 5
HtCap_LOWER1 = MAX((917.*3600./1000.*1.2*1.007*(35 - [3,1])),0.) ! Maximum reheat capacity for LOWER1 based on max airflow 917 L/s, air density 1.2 kg/m³, Cp_air 1.007 kJ/(kg.K), max reheat temp 35°C. HtCap_LOWER1 [kJ/hr]; from [3,1] TAIR_LOWER1 [°C]; to -> [7,11] Input Value-11 [kJ/hr]
HtCap_LOWER2 = MAX((817.*3600./1000.*1.2*1.007*(35 - [3,2])),0.) ! Maximum reheat capacity for LOWER2 based on max airflow 817 L/s. HtCap_LOWER2 [kJ/hr]; from [3,2] TAIR_LOWER2 [°C]; to -> [7,12] Input Value-12 [kJ/hr]
HtCap_LOWER3 = MAX((1069.*3600./1000.*1.2*1.007*(35 - [3,3])),0.) ! Maximum reheat capacity for LOWER3 based on max airflow 1069 L/s. HtCap_LOWER3 [kJ/hr]; from [3,3] TAIR_LOWER3 [°C]; to -> [7,13] Input Value-13 [kJ/hr]
HtCap_LOWER4 = MAX((921.*3600./1000.*1.2*1.007*(35 - [3,4])),0.) ! Maximum reheat capacity for LOWER4 based on max airflow 921 L/s. HtCap_LOWER4 [kJ/hr]; from [3,4] TAIR_LOWER4 [°C]; to -> [7,14] Input Value-14 [kJ/hr]
HtCap_UPPER = MAX((3786.*3600./1000.*1.2*1.007*(35 - [3,5])),0.) ! Maximum reheat capacity for UPPER based on max airflow 3786 L/s. HtCap_UPPER [kJ/hr]; from [3,5] TAIR_UPPER [°C]; to -> [7,15] Input Value-15 [kJ/hr]
*$UNIT_NAME Heating_Capacity_Limits
*$LAYER Main
*$POSITION 892 147
*$UNIT_NUMBER 35
*------------------------------------------------------------------------------

END
