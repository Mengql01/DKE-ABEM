  EQUATIONS  31
! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     AZEN = [2,16]
! Solar azimuth angle from weather data (0=south, 90=west, -90=east). AAZM [degrees]; from [2,17] solar azimuth angle [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     AAZM = [2,17]
! Solar azimuth angle corrected by building rotation for Type56 sun position. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     AAZM_TYPE56 = AAZM - (TURN)
! Azimuth angle of horizontal surface (slope=0, azimuth=0). AA_H_0_0 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     AA_H_0_0 = 0 + TURN
! Azimuth angle of south-facing 25° tilted surface. AA_S_0_25 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     AA_S_0_25 = 0 + TURN
! Azimuth angle of south-facing vertical surface. AA_S_0_90 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     AA_S_0_90 = 0 + TURN
! Azimuth angle of west-facing vertical surface. AA_W_90_90 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     AA_W_90_90 = 90 + TURN
! Azimuth angle of north-facing 25° tilted surface. AA_N_180_25 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     AA_N_180_25 = 180 + TURN
! Azimuth angle of north-facing vertical surface. AA_N_180_90 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     AA_N_180_90 = 180 + TURN
! Azimuth angle of east-facing vertical surface. AA_E_270_90 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     AA_E_270_90 = 270 + TURN
! Total radiation on horizontal surface converted from kJ/hr.m² to W/m². IT_H_0_0 [W/m²]; from [2,24] total radiation on surface 1 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     IT_H_0_0 = [2,24]/3.6
! Beam radiation on horizontal surface converted from kJ/hr.m² to W/m². IB_H_0_0 [W/m²]; from [2,31] beam radiation on surface 1 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     IB_H_0_0 = [2,31]/3.6
! Angle of incidence on horizontal surface. AI_H_0_0 [degrees]; from [2,59] angle of incidence for surface 1 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     AI_H_0_0 = [2,59]
! Total radiation on south 25° tilted surface converted from kJ/hr.m² to W/m². IT_S_0_25 [W/m²]; from [2,25] total radiation on surface 2 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     IT_S_0_25 = [2,25]/3.6
! Beam radiation on south 25° tilted surface converted from kJ/hr.m² to W/m². IB_S_0_25 [W/m²]; from [2,32] beam radiation on surface 2 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     IB_S_0_25 = [2,32]/3.6
! Angle of incidence on south 25° tilted surface. AI_S_0_25 [degrees]; from [2,60] angle of incidence for surface 2 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     AI_S_0_25 = [2,60]
! Total radiation on south vertical surface converted from kJ/hr.m² to W/m². IT_S_0_90 [W/m²]; from [2,26] total radiation on surface 3 [kJ/hr.m²]; to -> [5,1] Upper input value [W/m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     IT_S_0_90 = [2,26]/3.6
! Beam radiation on south vertical surface converted from kJ/hr.m² to W/m². IB_S_0_90 [W/m²]; from [2,33] beam radiation on surface 3 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     IB_S_0_90 = [2,33]/3.6
! Angle of incidence on south vertical surface. AI_S_0_90 [degrees]; from [2,61] angle of incidence for surface 3 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     AI_S_0_90 = [2,61]
! Total radiation on west vertical surface converted from kJ/hr.m² to W/m². IT_W_90_90 [W/m²]; from [2,27] total radiation on surface 4 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     IT_W_90_90 = [2,27]/3.6
! Beam radiation on west vertical surface converted from kJ/hr.m² to W/m². IB_W_90_90 [W/m²]; from [2,34] beam radiation on surface 4 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     IB_W_90_90 = [2,34]/3.6
! Angle of incidence on west vertical surface. AI_W_90_90 [degrees]; from [2,62] angle of incidence for surface 4 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     AI_W_90_90 = [2,62]
! Total radiation on north 25° tilted surface converted from kJ/hr.m² to W/m². IT_N_180_25 [W/m²]; from [2,28] total radiation on surface 5 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     IT_N_180_25 = [2,28]/3.6
! Beam radiation on north 25° tilted surface converted from kJ/hr.m² to W/m². IB_N_180_25 [W/m²]; from [2,35] beam radiation on surface 5 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     IB_N_180_25 = [2,35]/3.6
