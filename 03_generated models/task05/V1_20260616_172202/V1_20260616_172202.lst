     IT_N_180_90 = [2,29]/3.6
! Beam radiation on north vertical surface converted from kJ/hr.m² to W/m². IB_N_180_90 [W/m²]; from [2,36] beam radiation on surface 6 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     IB_N_180_90 = [2,36]/3.6
