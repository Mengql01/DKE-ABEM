* EQUATIONS "Chilled_Water_Signals"
*
EQUATIONS 9
T_CHW_IN = 20 + 3*SIN(TIME*10) ! Sinusoidal chilled water inlet temperature for dynamic performance testing, range ~17-23°C. T_CHW_IN [°C]; to -> [3,1] Chilled Water Inlet Temperature [°C]
M_CHW = 10000 ! Chilled water mass flow rate, constant at 10000 kg/hr. M_CHW [kg/hr]; to -> [3,2] Chilled Water Flowrate [kg/hr]
T_CHW_SET = 7 ! Chilled water outlet temperature setpoint. T_CHW_SET [°C]; to -> [3,5] CHW Set Point Temperature [°C]
CTRL_CHILLER = 1 ! Chiller control signal, 1=continuous operation. CTRL_CHILLER [-]; to -> [3,6] Chiller Control Signal [-]
CTRL_TOWER = 1 ! Cooling tower fan control signal, 1=continuous operation at rated speed. CTRL_TOWER [-]; to -> [4,7] Fan control signal [-]
CTRL_PUMP = 1 ! Condenser pump control signal, 1=continuous operation. CTRL_PUMP [-]; to -> [5,3] Control signal [-]
T_TOWER_SET = 30 ! Cooling tower desired outlet fluid temperature. T_TOWER_SET [°C]; to -> [4,8] Desired Outlet Temperature [°C]
EFF_PUMP = 0.6 ! Overall pump efficiency (includes impeller and hydraulic losses). EFF_PUMP [-]; to -> [5,4] Overall pump efficiency [-]
EFF_MOTOR = 0.9 ! Pump motor efficiency. EFF_MOTOR [-]; to -> [5,5] Motor efficiency [-]
*$UNIT_NAME Chilled_Water_Signals
*$LAYER Main
*$POSITION 140 147
*$UNIT_NUMBER 8
