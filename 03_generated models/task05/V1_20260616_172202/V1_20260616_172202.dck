* EQUATIONS "Wizard_Settings"
*
EQUATIONS 11
HEMISPHERE = 1 ! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]
TURN = HEMISPHERE * 0 ! Building rotation angle for adapting azimuth angles. TURN [degrees]
TBOUNDARY = 20 ! Building boundary temperature for boundary walls and ceilings. TBOUNDARY [°C]; to -> [3,9] Boundary Temperature [°C]
SHADE_CLOSE = 140 * 3.6 ! Threshold of total radiation on facade where shading device is activated (140 W/m² converted to kJ/hr.m²). SHADE_CLOSE [kJ/hr.m²]; to -> [3,10] SHADE_CLOSE [kJ/hr.m²]
SHADE_OPEN = 120 * 3.6 ! Threshold of total radiation on facade where shading device is deactivated (120 W/m² converted to kJ/hr.m²). SHADE_OPEN [kJ/hr.m²]; to -> [3,11] SHADE_OPEN [kJ/hr.m²]
MAX_ISHADE = 0.70 ! Maximum opacity of internal shading devices (70%). MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE [-]
MAX_ESHADE = 0.70 ! Maximum opacity of external shading devices (70%). MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE [-]
h_DEPTH = 1.0 ! Depth below ground surface for soil temperature calculation. h_DEPTH [m]
T_MEAN = 9.0 ! Mean annual surface temperature for ground temperature model. T_MEAN [°C]
T_AMPLITUDE = 9.0 ! Amplitude of annual surface temperature variation. T_AMPLITUDE [deltaC]
t_T_MIN = 11 ! Month of minimum surface temperature (11 = November). t_T_MIN [month]
*$UNIT_NAME Wizard_Settings
*$LAYER Main
*$POSITION 140 355.0
*$UNIT_NUMBER 12
*------------------------------------------------------------------------------

* EQUATIONS "Radiation_Unit_Converter"
*
EQUATIONS 31
AZEN = [2,16] ! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]
AAZM = [2,17] ! Solar azimuth angle from weather data (0=south, 90=west, -90=east). AAZM [degrees]; from [2,17] solar azimuth angle [degrees]
AAZM_TYPE56 = AAZM - (TURN) ! Solar azimuth angle corrected by building rotation for Type56 sun position. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]
AA_H_0_0 = 0 + TURN ! Azimuth angle of horizontal surface (slope=0, azimuth=0). AA_H_0_0 [degrees]
AA_S_0_25 = 0 + TURN ! Azimuth angle of south-facing 25° tilted surface. AA_S_0_25 [degrees]
AA_S_0_90 = 0 + TURN ! Azimuth angle of south-facing vertical surface. AA_S_0_90 [degrees]
AA_W_90_90 = 90 + TURN ! Azimuth angle of west-facing vertical surface. AA_W_90_90 [degrees]
AA_N_180_25 = 180 + TURN ! Azimuth angle of north-facing 25° tilted surface. AA_N_180_25 [degrees]
AA_N_180_90 = 180 + TURN ! Azimuth angle of north-facing vertical surface. AA_N_180_90 [degrees]
AA_E_270_90 = 270 + TURN ! Azimuth angle of east-facing vertical surface. AA_E_270_90 [degrees]
IT_H_0_0 = [2,24]/3.6 ! Total radiation on horizontal surface converted from kJ/hr.m² to W/m². IT_H_0_0 [W/m²]; from [2,24] total radiation on surface 1 [kJ/hr.m²]
IB_H_0_0 = [2,31]/3.6 ! Beam radiation on horizontal surface converted from kJ/hr.m² to W/m². IB_H_0_0 [W/m²]; from [2,31] beam radiation on surface 1 [kJ/hr.m²]
AI_H_0_0 = [2,59] ! Angle of incidence on horizontal surface. AI_H_0_0 [degrees]; from [2,59] angle of incidence for surface 1 [degrees]
IT_S_0_25 = [2,25]/3.6 ! Total radiation on south 25° tilted surface converted from kJ/hr.m² to W/m². IT_S_0_25 [W/m²]; from [2,25] total radiation on surface 2 [kJ/hr.m²]
IB_S_0_25 = [2,32]/3.6 ! Beam radiation on south 25° tilted surface converted from kJ/hr.m² to W/m². IB_S_0_25 [W/m²]; from [2,32] beam radiation on surface 2 [kJ/hr.m²]
AI_S_0_25 = [2,60] ! Angle of incidence on south 25° tilted surface. AI_S_0_25 [degrees]; from [2,60] angle of incidence for surface 2 [degrees]
IT_S_0_90 = [2,26]/3.6 ! Total radiation on south vertical surface converted from kJ/hr.m² to W/m². IT_S_0_90 [W/m²]; from [2,26] total radiation on surface 3 [kJ/hr.m²]; to -> [5,1] Upper input value [W/m²]
IB_S_0_90 = [2,33]/3.6 ! Beam radiation on south vertical surface converted from kJ/hr.m² to W/m². IB_S_0_90 [W/m²]; from [2,33] beam radiation on surface 3 [kJ/hr.m²]
AI_S_0_90 = [2,61] ! Angle of incidence on south vertical surface. AI_S_0_90 [degrees]; from [2,61] angle of incidence for surface 3 [degrees]
IT_W_90_90 = [2,27]/3.6 ! Total radiation on west vertical surface converted from kJ/hr.m² to W/m². IT_W_90_90 [W/m²]; from [2,27] total radiation on surface 4 [kJ/hr.m²]
IB_W_90_90 = [2,34]/3.6 ! Beam radiation on west vertical surface converted from kJ/hr.m² to W/m². IB_W_90_90 [W/m²]; from [2,34] beam radiation on surface 4 [kJ/hr.m²]
AI_W_90_90 = [2,62] ! Angle of incidence on west vertical surface. AI_W_90_90 [degrees]; from [2,62] angle of incidence for surface 4 [degrees]
IT_N_180_25 = [2,28]/3.6 ! Total radiation on north 25° tilted surface converted from kJ/hr.m² to W/m². IT_N_180_25 [W/m²]; from [2,28] total radiation on surface 5 [kJ/hr.m²]
IB_N_180_25 = [2,35]/3.6 ! Beam radiation on north 25° tilted surface converted from kJ/hr.m² to W/m². IB_N_180_25 [W/m²]; from [2,35] beam radiation on surface 5 [kJ/hr.m²]
