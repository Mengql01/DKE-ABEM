     AI_N_180_90 = [2,64]
! Total radiation on east vertical surface converted from kJ/hr.m² to W/m². IT_E_270_90 [W/m²]; from [2,30] total radiation on surface 7 [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     IT_E_270_90 = [2,30]/3.6
