     lgt_LOWER1 = (13.)*flr_LOWER1*3.6*[15,1]
! Lighting gain for LOWER2, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER2 [kJ/hr]; from [15,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     lgt_LOWER2 = (13.)*flr_LOWER2*3.6*[15,1]
! Lighting gain for LOWER3, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER3 [kJ/hr]; from [15,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     lgt_LOWER3 = (13.)*flr_LOWER3*3.6*[15,1]
! Lighting gain for LOWER4, 13 W/m² converted to kJ/hr with schedule. lgt_LOWER4 [kJ/hr]; from [15,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     lgt_LOWER4 = (13.)*flr_LOWER4*3.6*[15,1]
