*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "ASHP_LOWER1_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  13
! Heating capacity for LOWER1 ASHP converted from kW to kJ/hr (25% oversize). HCap_LWR1 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     HCap_LWR1 = 11.97*3600
! Cooling capacity for LOWER1 ASHP converted from kW to kJ/hr (15% oversize). CCap_LWR1 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     CCap_LWR1 = 12.2*3600
! Indoor fan efficiency for LOWER1 per ASHRAE 90.1-2007. effFan_LWR1 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     effFan_LWR1 = 0.84
! Condenser (outdoor) fan power for LOWER1 converted from kW to kJ/hr. pCondFan_LWR1 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     pCondFan_LWR1 = 0.062*3600
! Supply air flow rate for LOWER1 per ASHRAE 90.1-2007 G3.1.2.8: max(capacity)/(1.007*11)/1.2*1000. lps_LWR1 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lps_LWR1 = MAX(HCap_LWR1,CCap_LWR1)/(1.007*11)/1.2*1000/3600
! Rated supply air mass flow rate for LOWER1 converted from L/s to kg/hr. kghAir_LWR1 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     kghAir_LWR1 = lps_LWR1*3600/1000*1.2
! Total fan power allowance for LOWER1 per ASHRAE 90.1-2007 G3.1.2.9: 0.64 W/(L/s) converted to kJ/hr. pTotFan_LWR1 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     pTotFan_LWR1 = lps_LWR1*0.64*3.6
! Rated outdoor air mass flow rate for LOWER1 converted from L/s to kg/hr. kghOA_LWR1 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     kghOA_LWR1 = lpsOA_LWR1*3600/1000*1.2
! Indoor fan power for LOWER1 equals total fan power (no exhaust fans). pInFan_LWR1 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     pInFan_LWR1 = pTotFan_LWR1
! Indoor fan control signal for LOWER1: ON when thermostat calls OR during occupied period. yInFan_LWR1 [-]; from [10,3] Conditioning signal [-]; to -> [5,13] Fan Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     yInFan_LWR1 = OR([10,3], yVentAvail)
! Current return air mass flow rate for LOWER1: total supply minus outdoor air when fan runs. mRetNow_LWR1 [kg/hr]; to -> [5,4] Return Air Flow Rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     mRetNow_LWR1 = kghAir_LWR1*yInFan_LWR1 - kghOA_LWR1*yVentAvail
! Current outdoor air mass flow rate for LOWER1 gated by ventilation schedule. mOANow_LWR1 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     mOANow_LWR1 = kghOA_LWR1*yVentAvail
! Outdoor air damper position for LOWER1: ratio of OA flow to total supply flow. fOADmpr_LWR1 [-]; to -> [5,14] Outside Air Damper Position [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     fOADmpr_LWR1 = mOANow_LWR1/MAX(0.0001, yInFan_LWR1*kghAir_LWR1)
*$UNIT_NAME ASHP_LOWER1_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 1036 147                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*$UNIT_NUMBER 30                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "ASHP_LOWER2_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  13
! Heating capacity for LOWER2 ASHP converted from kW to kJ/hr. HCap_LWR2 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     HCap_LWR2 = 8.06*3600
! Cooling capacity for LOWER2 ASHP converted from kW to kJ/hr. CCap_LWR2 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     CCap_LWR2 = 10.87*3600
! Indoor fan efficiency for LOWER2 per ASHRAE 90.1-2007. effFan_LWR2 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     effFan_LWR2 = 0.84
! Condenser (outdoor) fan power for LOWER2 converted from kW to kJ/hr. pCondFan_LWR2 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     pCondFan_LWR2 = 0.062*3600
! Supply air flow rate for LOWER2 per ASHRAE 90.1-2007 G3.1.2.8. lps_LWR2 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     lps_LWR2 = MAX(HCap_LWR2,CCap_LWR2)/(1.007*11)/1.2*1000/3600
! Rated supply air mass flow rate for LOWER2 converted from L/s to kg/hr. kghAir_LWR2 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     kghAir_LWR2 = lps_LWR2*3600/1000*1.2
! Total fan power allowance for LOWER2 per ASHRAE 90.1-2007 G3.1.2.9. pTotFan_LWR2 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pTotFan_LWR2 = lps_LWR2*0.64*3.6
! Rated outdoor air mass flow rate for LOWER2 converted from L/s to kg/hr. kghOA_LWR2 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     kghOA_LWR2 = lpsOA_LWR2*3600/1000*1.2
! Indoor fan power for LOWER2 equals total fan power. pInFan_LWR2 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pInFan_LWR2 = pTotFan_LWR2
! Indoor fan control signal for LOWER2: ON when thermostat calls OR during occupied period. yInFan_LWR2 [-]; from [11,3] Conditioning signal [-]; to -> [6,13] Fan Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     yInFan_LWR2 = OR([11,3], yVentAvail)
! Current return air mass flow rate for LOWER2. mRetNow_LWR2 [kg/hr]; to -> [6,4] Return Air Flow Rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     mRetNow_LWR2 = kghAir_LWR2*yInFan_LWR2 - kghOA_LWR2*yVentAvail
! Current outdoor air mass flow rate for LOWER2 gated by ventilation schedule. mOANow_LWR2 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     mOANow_LWR2 = kghOA_LWR2*yVentAvail
! Outdoor air damper position for LOWER2. fOADmpr_LWR2 [-]; to -> [6,14] Outside Air Damper Position [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     fOADmpr_LWR2 = mOANow_LWR2/MAX(0.0001, yInFan_LWR2*kghAir_LWR2)
*$UNIT_NAME ASHP_LOWER2_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 1036 339.0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
*$UNIT_NUMBER 31                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "ASHP_LOWER3_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  13
! Heating capacity for LOWER3 ASHP converted from kW to kJ/hr. HCap_LWR3 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     HCap_LWR3 = 14.21*3600
! Cooling capacity for LOWER3 ASHP converted from kW to kJ/hr. CCap_LWR3 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     CCap_LWR3 = 13.38*3600
! Indoor fan efficiency for LOWER3 per ASHRAE 90.1-2007. effFan_LWR3 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     effFan_LWR3 = 0.84
! Condenser (outdoor) fan power for LOWER3 converted from kW to kJ/hr. pCondFan_LWR3 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     pCondFan_LWR3 = 0.062*3600
! Supply air flow rate for LOWER3 per ASHRAE 90.1-2007 G3.1.2.8. lps_LWR3 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     lps_LWR3 = MAX(HCap_LWR3,CCap_LWR3)/(1.007*11)/1.2*1000/3600
! Rated supply air mass flow rate for LOWER3 converted from L/s to kg/hr. kghAir_LWR3 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     kghAir_LWR3 = lps_LWR3*3600/1000*1.2
! Total fan power allowance for LOWER3 per ASHRAE 90.1-2007 G3.1.2.9. pTotFan_LWR3 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pTotFan_LWR3 = lps_LWR3*0.64*3.6
! Rated outdoor air mass flow rate for LOWER3 converted from L/s to kg/hr. kghOA_LWR3 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     kghOA_LWR3 = lpsOA_LWR3*3600/1000*1.2
! Indoor fan power for LOWER3 equals total fan power. pInFan_LWR3 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pInFan_LWR3 = pTotFan_LWR3
! Indoor fan control signal for LOWER3: ON when thermostat calls OR during occupied period. yInFan_LWR3 [-]; from [12,3] Conditioning signal [-]; to -> [7,13] Fan Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     yInFan_LWR3 = OR([12,3], yVentAvail)
! Current return air mass flow rate for LOWER3. mRetNow_LWR3 [kg/hr]; to -> [7,4] Return Air Flow Rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     mRetNow_LWR3 = kghAir_LWR3*yInFan_LWR3 - kghOA_LWR3*yVentAvail
! Current outdoor air mass flow rate for LOWER3 gated by ventilation schedule. mOANow_LWR3 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     mOANow_LWR3 = kghOA_LWR3*yVentAvail
! Outdoor air damper position for LOWER3. fOADmpr_LWR3 [-]; to -> [7,14] Outside Air Damper Position [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     fOADmpr_LWR3 = mOANow_LWR3/MAX(0.0001, yInFan_LWR3*kghAir_LWR3)
*$UNIT_NAME ASHP_LOWER3_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 1036 435                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*$UNIT_NUMBER 32                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "ASHP_LOWER4_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  13
! Heating capacity for LOWER4 ASHP converted from kW to kJ/hr. HCap_LWR4 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     HCap_LWR4 = 12.25*3600
! Cooling capacity for LOWER4 ASHP converted from kW to kJ/hr. CCap_LWR4 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     CCap_LWR4 = 11.78*3600
! Indoor fan efficiency for LOWER4 per ASHRAE 90.1-2007. effFan_LWR4 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     effFan_LWR4 = 0.84
! Condenser (outdoor) fan power for LOWER4 converted from kW to kJ/hr. pCondFan_LWR4 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     pCondFan_LWR4 = 0.062*3600
! Supply air flow rate for LOWER4 per ASHRAE 90.1-2007 G3.1.2.8. lps_LWR4 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     lps_LWR4 = MAX(HCap_LWR4,CCap_LWR4)/(1.007*11)/1.2*1000/3600
! Rated supply air mass flow rate for LOWER4 converted from L/s to kg/hr. kghAir_LWR4 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     kghAir_LWR4 = lps_LWR4*3600/1000*1.2
! Total fan power allowance for LOWER4 per ASHRAE 90.1-2007 G3.1.2.9. pTotFan_LWR4 [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pTotFan_LWR4 = lps_LWR4*0.64*3.6
! Rated outdoor air mass flow rate for LOWER4 converted from L/s to kg/hr. kghOA_LWR4 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     kghOA_LWR4 = lpsOA_LWR4*3600/1000*1.2
! Indoor fan power for LOWER4 equals total fan power. pInFan_LWR4 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pInFan_LWR4 = pTotFan_LWR4
! Indoor fan control signal for LOWER4: ON when thermostat calls OR during occupied period. yInFan_LWR4 [-]; from [13,3] Conditioning signal [-]; to -> [8,13] Fan Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     yInFan_LWR4 = OR([13,3], yVentAvail)
! Current return air mass flow rate for LOWER4. mRetNow_LWR4 [kg/hr]; to -> [8,4] Return Air Flow Rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     mRetNow_LWR4 = kghAir_LWR4*yInFan_LWR4 - kghOA_LWR4*yVentAvail
! Current outdoor air mass flow rate for LOWER4 gated by ventilation schedule. mOANow_LWR4 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     mOANow_LWR4 = kghOA_LWR4*yVentAvail
! Outdoor air damper position for LOWER4. fOADmpr_LWR4 [-]; to -> [8,14] Outside Air Damper Position [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     fOADmpr_LWR4 = mOANow_LWR4/MAX(0.0001, yInFan_LWR4*kghAir_LWR4)
*$UNIT_NAME ASHP_LOWER4_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 1036 579.0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
*$UNIT_NUMBER 33                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "ASHP_UPPER_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  13
! Heating capacity for UPPER ASHP converted from kW to kJ/hr. HCap_UPR [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     HCap_UPR = 50.32*3600
! Cooling capacity for UPPER ASHP converted from kW to kJ/hr. CCap_UPR [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     CCap_UPR = 39.86*3600
! Indoor fan efficiency for UPPER per ASHRAE 90.1-2007. effFan_UPR [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     effFan_UPR = 0.84
! Condenser (outdoor) fan power for UPPER converted from kW to kJ/hr. pCondFan_UPR [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     pCondFan_UPR = 0.062*3600
! Supply air flow rate for UPPER per ASHRAE 90.1-2007 G3.1.2.8. lps_UPR [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     lps_UPR = MAX(HCap_UPR,CCap_UPR)/(1.007*11)/1.2*1000/3600
! Rated supply air mass flow rate for UPPER converted from L/s to kg/hr. kghAir_UPR [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     kghAir_UPR = lps_UPR*3600/1000*1.2
! Total fan power allowance for UPPER per ASHRAE 90.1-2007 G3.1.2.9. pTotFan_UPR [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     pTotFan_UPR = lps_UPR*0.64*3.6
! Rated outdoor air mass flow rate for UPPER converted from L/s to kg/hr. kghOA_UPR [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     kghOA_UPR = lpsOA_UPR*3600/1000*1.2
! Indoor fan power for UPPER equals total fan power. pInFan_UPR [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     pInFan_UPR = pTotFan_UPR
! Indoor fan control signal for UPPER: ON when thermostat calls OR during occupied period. yInFan_UPR [-]; from [14,3] Conditioning signal [-]; to -> [9,13] Fan Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     yInFan_UPR = OR([14,3], yVentAvail)
! Current return air mass flow rate for UPPER. mRetNow_UPR [kg/hr]; to -> [9,4] Return Air Flow Rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     mRetNow_UPR = kghAir_UPR*yInFan_UPR - kghOA_UPR*yVentAvail
! Current outdoor air mass flow rate for UPPER gated by ventilation schedule. mOANow_UPR [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     mOANow_UPR = kghOA_UPR*yVentAvail
! Outdoor air damper position for UPPER. fOADmpr_UPR [-]; to -> [9,14] Outside Air Damper Position [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     fOADmpr_UPR = mOANow_UPR/MAX(0.0001, yInFan_UPR*kghAir_UPR)
*$UNIT_NAME ASHP_UPPER_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 1036 675                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
*$UNIT_NUMBER 34                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Building_Control_Equations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   4
! Outdoor convection coefficient from wind speed: h=3.6*(3.8*max(0,wind)+7.4). h_outside [kJ/(hr.m2.K)]; from [2,8] Wind velocity [m/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     h_outside = 3.6*(3.8*MAX(0,[2,8])+7.4)
! Day of week index: 0=Monday, 1=Tuesday, ..., 5=Saturday, 6=Sunday. DAY [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     DAY = MOD(INT(TIME/24),7)
! Hour of day from simulation time (0-24). HOUR [hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     HOUR = MOD(TIME,24)
! Ventilation availability schedule: weekday (Mon-Fri) and Saturday 8:00-17:00 ON, Sunday OFF. yVentAvail [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     yVentAvail = GE(HOUR,8)*LT(HOUR,17)*LE(DAY,4) + GE(HOUR,8)*LT(HOUR,17)*EQL(DAY,5)
*$UNIT_NAME Building_Control_Equations                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 328.0 339.0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
*$UNIT_NUMBER 35                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         

  END


