* EQUATIONS "System_Constants"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   6
! Fresh air fraction for mixing with return air. FRAC_OA [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     FRAC_OA = 0.15
! Rated supply air mass flow rate calculated from rated volumetric flow (277.8 l/s) and air density (1.2 kg/m³). M_RATED_AIR [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     M_RATED_AIR = 277.8*3.6*1.2
! Chilled water pump inlet fluid temperature. T_CHW_IN [°C]; to -> [6,1] Inlet fluid temperature [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     T_CHW_IN = 10
! Hot water pump inlet fluid temperature. T_HW_IN [°C]; to -> [7,1] Inlet fluid temperature [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     T_HW_IN = 50
! Outdoor fresh air mass flow rate (15% of rated supply air flow). M_OA [kg/hr]; to -> [8,9] Inlet Air Flow Rate - 2 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     M_OA = FRAC_OA * M_RATED_AIR
! Return air mass flow rate (85% of rated supply air flow). M_RA [kg/hr]; to -> [8,4] Inlet Air Flow Rate - 1 [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     M_RA = (1-FRAC_OA) * M_RATED_AIR
*$UNIT_NAME System_Constants                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
