* EQUATIONS "Radiation_Unit_Converter"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   7
! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] Solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     AZEN = [2,16]
! Solar azimuth angle from weather data. AAZM [degrees]; from [2,17] Solar azimuth angle [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     AAZM = [2,17]
! Solar azimuth angle corrected by building rotation for Type56. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     AAZM_TYPE56 = AAZM - TURN
! Azimuth angle of horizontal surface (slope 0°, azimuth 0°). AA_H_0_0 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     AA_H_0_0 = 0 + TURN
! Total tilted surface radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IT_H_0_0 [W/m2]; from [2,24] Total tilted surface radiation for surface-1 [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     IT_H_0_0 = [2,24]/3.6
! Beam radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IB_H_0_0 [W/m2]; from [2,31] Beam radiation for surface-1 [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     IB_H_0_0 = [2,31]/3.6
! Incident angle on horizontal surface. AI_H_0_0 [degrees]; from [2,59] Incident angle for surface-1 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     AI_H_0_0 = [2,59]
*$UNIT_NAME Radiation_Unit_Converter                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
