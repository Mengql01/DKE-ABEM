* EQUATIONS "Wizard_Settings"
*
EQUATIONS 12
HEMISPHERE = 1 ! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]
TURN = HEMISPHERE * 0 ! Building rotation angle, 0=no rotation. TURN [degrees]; to -> [28,?] AAZM_TYPE56 calculation
TBOUNDARY = 0 ! Boundary temperature flag, 0=use TGROUND from Type77. TBOUNDARY [-]; to -> [3,9] TBOUNDARY
SHADE_CLOSE = 200 ! Radiation threshold to close window shades. SHADE_CLOSE [W/m2]; to -> [3,10] SHADE_CLOSE
SHADE_OPEN = 100 ! Radiation threshold to open window shades. SHADE_OPEN [W/m2]; to -> [3,11] SHADE_OPEN
MAX_ISHADE = 0.5 ! Maximum internal shade factor (0=no shade, 1=fully shaded). MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE
MAX_ESHADE = 0.5 ! Maximum external shade factor (0=no shade, 1=fully shaded). MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE
h_DEPTH = 0.1 ! Depth of heat transfer node for building surfaces. h_DEPTH [m]
T_MEAN = 10.0 ! Mean annual surface temperature for ground coupling. T_MEAN [°C]
T_AMPLITUDE = 5.0 ! Amplitude of surface temperature variation. T_AMPLITUDE [deltaC]
t_T_MIN = 30 ! Day of year when minimum surface temperature occurs. t_T_MIN [day]
TGROUND_FLAG = 1 ! Flag to use Type77 soil temperature for ground boundary. TGROUND_FLAG [-]
*$UNIT_NAME Wizard_Settings
*$LAYER Main
*$POSITION 140 339.0
*$UNIT_NUMBER 27
*------------------------------------------------------------------------------

* EQUATIONS "Radiation_Unit_Converter"
*
EQUATIONS 7
AZEN = [2,16] ! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] Solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]
AAZM = [2,17] ! Solar azimuth angle from weather data. AAZM [degrees]; from [2,17] Solar azimuth angle [degrees]
AAZM_TYPE56 = AAZM - TURN ! Solar azimuth angle corrected by building rotation for Type56. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]
AA_H_0_0 = 0 + TURN ! Azimuth angle of horizontal surface (slope 0°, azimuth 0°). AA_H_0_0 [degrees]
IT_H_0_0 = [2,24]/3.6 ! Total tilted surface radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IT_H_0_0 [W/m2]; from [2,24] Total tilted surface radiation for surface-1 [kJ/hr.m2]
IB_H_0_0 = [2,31]/3.6 ! Beam radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IB_H_0_0 [W/m2]; from [2,31] Beam radiation for surface-1 [kJ/hr.m2]
AI_H_0_0 = [2,59] ! Incident angle on horizontal surface. AI_H_0_0 [degrees]; from [2,59] Incident angle for surface-1 [degrees]
*$UNIT_NAME Radiation_Unit_Converter
*$LAYER Main
*$POSITION 328.0 147
*$UNIT_NUMBER 28
*------------------------------------------------------------------------------

* EQUATIONS "Zone_Parameters_and_Gains"
*
EQUATIONS 27
flr_LOWER1 = 150 ! Floor area of LOWER1 zone. flr_LOWER1 [m2]
flr_LOWER2 = 150 ! Floor area of LOWER2 zone. flr_LOWER2 [m2]
flr_LOWER3 = 150 ! Floor area of LOWER3 zone. flr_LOWER3 [m2]
flr_LOWER4 = 150 ! Floor area of LOWER4 zone. flr_LOWER4 [m2]
flr_UPPER = 400 ! Floor area of UPPER zone. flr_UPPER [m2]
lpsOA_LWR1 = 0.3*flr_LOWER1 + 2.5*8 ! Required outdoor air for LOWER1 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR1 [L/s]
lpsOA_LWR2 = 0.3*flr_LOWER2 + 2.5*8 ! Required outdoor air for LOWER2 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR2 [L/s]
lpsOA_LWR3 = 0.3*flr_LOWER3 + 2.5*8 ! Required outdoor air for LOWER3 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR3 [L/s]
lpsOA_LWR4 = 0.3*flr_LOWER4 + 2.5*8 ! Required outdoor air for LOWER4 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR4 [L/s]
lpsOA_UPR = 0.3*flr_UPPER + 2.5*10 ! Required outdoor air for UPPER per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 10 people. lpsOA_UPR [L/s]
lgt_LOWER1 = 13*flr_LOWER1*3.6*[22,1] ! Lighting heat gain for LOWER1 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER1 [kJ/hr]; from [22,1] Forcing function output for current day [-]
lgt_LOWER2 = 13*flr_LOWER2*3.6*[22,1] ! Lighting heat gain for LOWER2 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER2 [kJ/hr]; from [22,1] Forcing function output for current day [-]
lgt_LOWER3 = 13*flr_LOWER3*3.6*[22,1] ! Lighting heat gain for LOWER3 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER3 [kJ/hr]; from [22,1] Forcing function output for current day [-]
lgt_LOWER4 = 13*flr_LOWER4*3.6*[22,1] ! Lighting heat gain for LOWER4 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER4 [kJ/hr]; from [22,1] Forcing function output for current day [-]
lgt_UPPER = 13*flr_UPPER*3.6*[22,1] ! Lighting heat gain for UPPER at 13 W/m2, converted to kJ/hr with schedule. lgt_UPPER [kJ/hr]; from [22,1] Forcing function output for current day [-]
eqp_LOWER1 = 21.5*flr_LOWER1*3.6*[22,1] ! Equipment heat gain for LOWER1 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER1 [kJ/hr]; from [22,1] Forcing function output for current day [-]
eqp_LOWER2 = 21.5*flr_LOWER2*3.6*[22,1] ! Equipment heat gain for LOWER2 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER2 [kJ/hr]; from [22,1] Forcing function output for current day [-]
eqp_LOWER3 = 21.5*flr_LOWER3*3.6*[22,1] ! Equipment heat gain for LOWER3 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER3 [kJ/hr]; from [22,1] Forcing function output for current day [-]
eqp_LOWER4 = 21.5*flr_LOWER4*3.6*[22,1] ! Equipment heat gain for LOWER4 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER4 [kJ/hr]; from [22,1] Forcing function output for current day [-]
eqp_UPPER = 21.5*flr_UPPER*3.6*[22,1] ! Equipment heat gain for UPPER at 21.5 W/m2, converted to kJ/hr with schedule. eqp_UPPER [kJ/hr]; from [22,1] Forcing function output for current day [-]
peo_LOWER1 = flr_LOWER1/20*[21,1] ! Number of occupants in LOWER1 based on 20 m2/person with schedule. peo_LOWER1 [-]; from [21,1] Forcing function output for current day [-]
peo_LOWER2 = flr_LOWER2/20*[21,1] ! Number of occupants in LOWER2 based on 20 m2/person with schedule. peo_LOWER2 [-]; from [21,1] Forcing function output for current day [-]
peo_LOWER3 = flr_LOWER3/20*[21,1] ! Number of occupants in LOWER3 based on 20 m2/person with schedule. peo_LOWER3 [-]; from [21,1] Forcing function output for current day [-]
peo_LOWER4 = flr_LOWER4/20*[21,1] ! Number of occupants in LOWER4 based on 20 m2/person with schedule. peo_LOWER4 [-]; from [21,1] Forcing function output for current day [-]
peo_UPPER = flr_UPPER/20*[21,1] ! Number of occupants in UPPER based on 20 m2/person with schedule. peo_UPPER [-]; from [21,1] Forcing function output for current day [-]
lgt_Total = lgt_LOWER1 + lgt_LOWER2 + lgt_LOWER3 + lgt_LOWER4 + lgt_UPPER ! Total lighting heat gain across all zones. lgt_Total [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]
eqp_Total = eqp_LOWER1 + eqp_LOWER2 + eqp_LOWER3 + eqp_LOWER4 + eqp_UPPER ! Total equipment heat gain across all zones. eqp_Total [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]
*$UNIT_NAME Zone_Parameters_and_Gains
*$LAYER Main
*$POSITION 488 147
*$UNIT_NUMBER 29
*------------------------------------------------------------------------------

* EQUATIONS "ASHP_LOWER1_Equations"
*
EQUATIONS 13
HCap_LWR1 = 11.97*3600 ! Heating capacity for LOWER1 ASHP converted from kW to kJ/hr (25% oversize). HCap_LWR1 [kJ/hr]
CCap_LWR1 = 12.2*3600 ! Cooling capacity for LOWER1 ASHP converted from kW to kJ/hr (15% oversize). CCap_LWR1 [kJ/hr]
effFan_LWR1 = 0.84 ! Indoor fan efficiency for LOWER1 per ASHRAE 90.1-2007. effFan_LWR1 [-]
pCondFan_LWR1 = 0.062*3600 ! Condenser (outdoor) fan power for LOWER1 converted from kW to kJ/hr. pCondFan_LWR1 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]
lps_LWR1 = MAX(HCap_LWR1,CCap_LWR1)/(1.007*11)/1.2*1000/3600 ! Supply air flow rate for LOWER1 per ASHRAE 90.1-2007 G3.1.2.8: max(capacity)/(1.007*11)/1.2*1000. lps_LWR1 [L/s]
kghAir_LWR1 = lps_LWR1*3600/1000*1.2 ! Rated supply air mass flow rate for LOWER1 converted from L/s to kg/hr. kghAir_LWR1 [kg/hr]
pTotFan_LWR1 = lps_LWR1*0.64*3.6 ! Total fan power allowance for LOWER1 per ASHRAE 90.1-2007 G3.1.2.9: 0.64 W/(L/s) converted to kJ/hr. pTotFan_LWR1 [kJ/hr]
kghOA_LWR1 = lpsOA_LWR1*3600/1000*1.2 ! Rated outdoor air mass flow rate for LOWER1 converted from L/s to kg/hr. kghOA_LWR1 [kg/hr]
pInFan_LWR1 = pTotFan_LWR1 ! Indoor fan power for LOWER1 equals total fan power (no exhaust fans). pInFan_LWR1 [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]
yInFan_LWR1 = OR([10,3], yVentAvail) ! Indoor fan control signal for LOWER1: ON when thermostat calls OR during occupied period. yInFan_LWR1 [-]; from [10,3] Conditioning signal [-]; to -> [5,13] Fan Control Signal [-]
mRetNow_LWR1 = kghAir_LWR1*yInFan_LWR1 - kghOA_LWR1*yVentAvail ! Current return air mass flow rate for LOWER1: total supply minus outdoor air when fan runs. mRetNow_LWR1 [kg/hr]; to -> [5,4] Return Air Flow Rate [kg/hr]
mOANow_LWR1 = kghOA_LWR1*yVentAvail ! Current outdoor air mass flow rate for LOWER1 gated by ventilation schedule. mOANow_LWR1 [kg/hr]
fOADmpr_LWR1 = mOANow_LWR1/MAX(0.0001, yInFan_LWR1*kghAir_LWR1) ! Outdoor air damper position for LOWER1: ratio of OA flow to total supply flow. fOADmpr_LWR1 [-]; to -> [5,14] Outside Air Damper Position [-]
*$UNIT_NAME ASHP_LOWER1_Equations
*$LAYER Main
*$POSITION 1036 147
*$UNIT_NUMBER 30
*------------------------------------------------------------------------------

* EQUATIONS "ASHP_LOWER2_Equations"
*
EQUATIONS 13
HCap_LWR2 = 8.06*3600 ! Heating capacity for LOWER2 ASHP converted from kW to kJ/hr. HCap_LWR2 [kJ/hr]
CCap_LWR2 = 10.87*3600 ! Cooling capacity for LOWER2 ASHP converted from kW to kJ/hr. CCap_LWR2 [kJ/hr]
