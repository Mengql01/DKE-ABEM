* EQUATIONS "DHW_Calculations"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   2
! Actual DHW demand flow rate, scaled from normalized load profile by factor 200. mdDHW [kg/hr]; from [10,2] Instantaneous value of function over the timestep [-]; to -> [8,2] Inlet flow rate [kg/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     mdDHW = [10,2]*200
! Cold water supply temperature constant. TCold [°C]; to -> [8,1] Inlet temperature [°C]; to -> [7,3] Tempering Fluid Temperature (Return Temperature) [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     TCold = 15
