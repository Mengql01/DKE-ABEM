*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Wizard_Settings"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  12
! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     HEMISPHERE = 1
! Building rotation angle. TURN [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     TURN = HEMISPHERE * 0
! Boundary temperature for building model. TBOUNDARY [°C]; to -> [3,9] TBOUNDARY [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     TBOUNDARY = 20
! Radiation threshold to close blinds, converted from W/m2 to kJ/hr.m2. SHADE_CLOSE [kJ/hr.m2]; to -> [3,10] SHADE_CLOSE [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     SHADE_CLOSE = 140 * 3.6
! Radiation threshold to open blinds, converted from W/m2 to kJ/hr.m2. SHADE_OPEN [kJ/hr.m2]; to -> [3,11] SHADE_OPEN [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     SHADE_OPEN = 40 * 3.6
! Maximum internal shading factor. MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     MAX_ISHADE = 0.5
! Maximum external shading factor. MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     MAX_ESHADE = 0.5
! Depth below ground surface for soil temperature node. h_DEPTH [m]; to -> [4,8] Depth at point [m]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     h_DEPTH = 0.25
! Mean annual ground surface temperature. T_MEAN [°C]; to -> [4,2] Mean surface temperature [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     T_MEAN = 10.0
! Amplitude of ground surface temperature variation. T_AMPLITUDE [deltaC]; to -> [4,3] Amplitude of surface temperature [deltaC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     T_AMPLITUDE = 5.0
! Day of year when minimum ground surface temperature occurs. t_T_MIN [day]; to -> [4,4] Time shift [day]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     t_T_MIN = 30
! Default temperature setpoint placeholder. T_SET [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     T_SET = 22
*$UNIT_NAME Wizard_Settings                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 140 563.0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
*$UNIT_NUMBER 26                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Radiation_Unit_Converter"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   7
! Solar zenith angle from weather data. AZEN [degrees]; from [2,16] Solar zenith angle [degrees]; to -> [3,5] AZEN [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     AZEN = [2,16]
! Solar azimuth angle from weather data. AAZM [degrees]; from [2,17] Solar azimuth angle [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     AAZM = [2,17]
! Solar azimuth angle corrected by building rotation for Type56. AAZM_TYPE56 [degrees]; to -> [3,6] AAZM [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     AAZM_TYPE56 = AAZM - (TURN)
! Azimuth angle of horizontal surface (slope 0°, azimuth 0°). AA_H_0_0 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     AA_H_0_0 = 0 + TURN
! Total tilted surface radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IT_H_0_0 [W/m2]; from [2,24] Total radiation on surface 1 [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     IT_H_0_0 = [2,24]/3.6
! Beam radiation on horizontal surface, converted from kJ/hr.m2 to W/m2. IB_H_0_0 [W/m2]; from [2,31] Beam radiation on surface 1 [kJ/hr.m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     IB_H_0_0 = [2,31]/3.6
! Angle of incidence on horizontal surface. AI_H_0_0 [degrees]; from [2,59] Incidence angle for surface 1 [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
     AI_H_0_0 = [2,59]
*$UNIT_NAME Radiation_Unit_Converter                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
