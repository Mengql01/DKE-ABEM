     peo_LOWER3 = flr_LOWER3/(20.)*[11,1]
! Occupant count for LOWER4, 20 m²/person with occupancy schedule. peo_LOWER4 [-]; from [11,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     peo_LOWER4 = flr_LOWER4/(20.)*[11,1]
! Occupant count for UPPER, 20 m²/person with occupancy schedule. peo_UPPER [-]; from [11,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     peo_UPPER = flr_UPPER/(20.)*[11,1]
! Total lighting load across all zones. lgt_Total [kJ/hr]; to -> [24,1] Input to be integrated & printed [kJ/hr]; to -> [25,1] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     lgt_Total = lgt_LOWER1 + lgt_LOWER2 + lgt_LOWER3 + lgt_LOWER4 + lgt_UPPER
! Total equipment load across all zones. eqp_Total [kJ/hr]; to -> [24,1] Input to be integrated & printed [kJ/hr]; to -> [25,1] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     eqp_Total = eqp_LOWER1 + eqp_LOWER2 + eqp_LOWER3 + eqp_LOWER4 + eqp_UPPER
*$UNIT_NAME Gains                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
*$POSITION 552 147                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
*$UNIT_NUMBER 31                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "OA_Quantity"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS   6
! Required outside air for LOWER1 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER1 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     lpsOA_LOWER1 = (0.3)*flr_LOWER1 + (2.5)*8.
! Required outside air for LOWER2 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER2 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     lpsOA_LOWER2 = (0.3)*flr_LOWER2 + (2.5)*8.
! Required outside air for LOWER3 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER3 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     lpsOA_LOWER3 = (0.3)*flr_LOWER3 + (2.5)*8.
! Required outside air for LOWER4 using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 8 people. lpsOA_LOWER4 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     lpsOA_LOWER4 = (0.3)*flr_LOWER4 + (2.5)*8.
! Required outside air for UPPER using ventilation rate method: 0.3 L/(s.m²) area + 2.5 L/(s.person) for 10 people. lpsOA_UPPER [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     lpsOA_UPPER = (0.3)*flr_UPPER + (2.5)*10.
! Fraction of outside air relative to design dry air flow 7510 L/s, modulated by weekly ventilation schedule. fOA [-]; from [19,1] Forcing function output for current day [-]; to -> [5,6] Fraction of outside air [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     fOA = (lpsOA_LOWER1 + lpsOA_LOWER2 + lpsOA_LOWER3 + lpsOA_LOWER4 + lpsOA_UPPER) / 7510. * [19,1]
*$UNIT_NAME OA_Quantity                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
*$LAYER Main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
