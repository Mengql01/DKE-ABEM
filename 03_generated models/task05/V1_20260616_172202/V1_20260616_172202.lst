* EQUATIONS "Wizard_Settings"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  11
! Northern hemisphere flag, 1=Northern, -1=Southern. HEMISPHERE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     HEMISPHERE = 1
! Building rotation angle for adapting azimuth angles. TURN [degrees]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     TURN = HEMISPHERE * 0
! Building boundary temperature for boundary walls and ceilings. TBOUNDARY [°C]; to -> [3,9] Boundary Temperature [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
     TBOUNDARY = 20
! Threshold of total radiation on facade where shading device is activated (140 W/m² converted to kJ/hr.m²). SHADE_CLOSE [kJ/hr.m²]; to -> [3,10] SHADE_CLOSE [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     SHADE_CLOSE = 140 * 3.6
! Threshold of total radiation on facade where shading device is deactivated (120 W/m² converted to kJ/hr.m²). SHADE_OPEN [kJ/hr.m²]; to -> [3,11] SHADE_OPEN [kJ/hr.m²]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     SHADE_OPEN = 120 * 3.6
! Maximum opacity of internal shading devices (70%). MAX_ISHADE [-]; to -> [3,12] MAX_ISHADE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     MAX_ISHADE = 0.70
! Maximum opacity of external shading devices (70%). MAX_ESHADE [-]; to -> [3,13] MAX_ESHADE [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     MAX_ESHADE = 0.70
! Depth below ground surface for soil temperature calculation. h_DEPTH [m]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     h_DEPTH = 1.0
! Mean annual surface temperature for ground temperature model. T_MEAN [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     T_MEAN = 9.0
! Amplitude of annual surface temperature variation. T_AMPLITUDE [deltaC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     T_AMPLITUDE = 9.0
! Month of minimum surface temperature (11 = November). t_T_MIN [month]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     t_T_MIN = 11
