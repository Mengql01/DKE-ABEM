*------------------------------------------------------------------------------                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
* EQUATIONS "Zone_Parameters_and_Gains"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
*                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       

  EQUATIONS  27
! Floor area of LOWER1 zone. flr_LOWER1 [m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     flr_LOWER1 = 150
! Floor area of LOWER2 zone. flr_LOWER2 [m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     flr_LOWER2 = 150
! Floor area of LOWER3 zone. flr_LOWER3 [m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     flr_LOWER3 = 150
! Floor area of LOWER4 zone. flr_LOWER4 [m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     flr_LOWER4 = 150
! Floor area of UPPER zone. flr_UPPER [m2]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     flr_UPPER = 400
! Required outdoor air for LOWER1 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR1 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     lpsOA_LWR1 = 0.3*flr_LOWER1 + 2.5*8
! Required outdoor air for LOWER2 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR2 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     lpsOA_LWR2 = 0.3*flr_LOWER2 + 2.5*8
! Required outdoor air for LOWER3 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR3 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     lpsOA_LWR3 = 0.3*flr_LOWER3 + 2.5*8
! Required outdoor air for LOWER4 per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 8 people. lpsOA_LWR4 [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
     lpsOA_LWR4 = 0.3*flr_LOWER4 + 2.5*8
! Required outdoor air for UPPER per ventilation rate method: 0.3 L/(s.m2) area + 2.5 L/(s.person) for 10 people. lpsOA_UPR [L/s]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     lpsOA_UPR = 0.3*flr_UPPER + 2.5*10
! Lighting heat gain for LOWER1 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER1 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lgt_LOWER1 = 13*flr_LOWER1*3.6*[22,1]
! Lighting heat gain for LOWER2 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER2 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lgt_LOWER2 = 13*flr_LOWER2*3.6*[22,1]
! Lighting heat gain for LOWER3 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER3 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lgt_LOWER3 = 13*flr_LOWER3*3.6*[22,1]
! Lighting heat gain for LOWER4 at 13 W/m2, converted to kJ/hr with schedule. lgt_LOWER4 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lgt_LOWER4 = 13*flr_LOWER4*3.6*[22,1]
! Lighting heat gain for UPPER at 13 W/m2, converted to kJ/hr with schedule. lgt_UPPER [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     lgt_UPPER = 13*flr_UPPER*3.6*[22,1]
! Equipment heat gain for LOWER1 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER1 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     eqp_LOWER1 = 21.5*flr_LOWER1*3.6*[22,1]
! Equipment heat gain for LOWER2 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER2 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     eqp_LOWER2 = 21.5*flr_LOWER2*3.6*[22,1]
! Equipment heat gain for LOWER3 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER3 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     eqp_LOWER3 = 21.5*flr_LOWER3*3.6*[22,1]
! Equipment heat gain for LOWER4 at 21.5 W/m2, converted to kJ/hr with schedule. eqp_LOWER4 [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     eqp_LOWER4 = 21.5*flr_LOWER4*3.6*[22,1]
! Equipment heat gain for UPPER at 21.5 W/m2, converted to kJ/hr with schedule. eqp_UPPER [kJ/hr]; from [22,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     eqp_UPPER = 21.5*flr_UPPER*3.6*[22,1]
! Number of occupants in LOWER1 based on 20 m2/person with schedule. peo_LOWER1 [-]; from [21,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     peo_LOWER1 = flr_LOWER1/20*[21,1]
! Number of occupants in LOWER2 based on 20 m2/person with schedule. peo_LOWER2 [-]; from [21,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     peo_LOWER2 = flr_LOWER2/20*[21,1]
! Number of occupants in LOWER3 based on 20 m2/person with schedule. peo_LOWER3 [-]; from [21,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     peo_LOWER3 = flr_LOWER3/20*[21,1]
! Number of occupants in LOWER4 based on 20 m2/person with schedule. peo_LOWER4 [-]; from [21,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     peo_LOWER4 = flr_LOWER4/20*[21,1]
! Number of occupants in UPPER based on 20 m2/person with schedule. peo_UPPER [-]; from [21,1] Forcing function output for current day [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     peo_UPPER = flr_UPPER/20*[21,1]
! Total lighting heat gain across all zones. lgt_Total [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     lgt_Total = lgt_LOWER1 + lgt_LOWER2 + lgt_LOWER3 + lgt_LOWER4 + lgt_UPPER
! Total equipment heat gain across all zones. eqp_Total [kJ/hr]; to -> [26,?] Input to be integrated & printed [kJ/hr]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     eqp_Total = eqp_LOWER1 + eqp_LOWER2 + eqp_LOWER3 + eqp_LOWER4 + eqp_UPPER
