  EQUATIONS   9
! Fixed upper input temperature setpoint for differential controller (reference for ON/OFF hysteresis). T_Set_Th [°C]; to -> [4,1] Upper input temperature Th [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     T_Set_Th = 55
! Upper deadband temperature difference: controller turns OFF when Tl rises above Th (55°C), turns ON when Tl drops below Th-dT_Upper (45°C). dT_Upper [deltaC]; to -> [4,5] Upper dead band dT [deltaC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     dT_Upper = 10
! Lower deadband temperature difference: set to 0 so only upper deadband governs the hysteresis. dT_Lower [deltaC]; to -> [4,6] Lower dead band dT [deltaC]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     dT_Lower = 0
! Cooling control signal fixed to 0 — heat pump operates in heating mode only. Cooling_Ctrl [-]; to -> [7,5] Cooling Control Signal [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     Cooling_Ctrl = 0
! Scale factor for single heat pump (1 = one unit at rated capacity). HP_Scale [-]; to -> [7,7] Scale Factor [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     HP_Scale = 1
! Number of identical heat pumps considered ON (1 unit). HP_Num_On [-]; to -> [7,8] Number of Heat Pumps On [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     HP_Num_On = 1
! Environment temperature surrounding the storage tank (assumed indoor installation at 20°C). T_Env [°C]; to -> [8,5] Environment temperature [°C]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
     T_Env = 20
! Control signal for auxiliary heating element 1 — disabled (max heating rate = 0 kJ/h). Aux1_Ctrl [-]; to -> [8,6] Control signal for element 1 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     Aux1_Ctrl = 0
! Control signal for auxiliary heating element 2 — disabled (max heating rate = 0 kJ/h). Aux2_Ctrl [-]; to -> [8,7] Control signal for element 2 [-]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
     Aux2_Ctrl = 0
